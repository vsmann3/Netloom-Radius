# Candidate settings for radius.netnoc.in, activated with the HTTPS deployment.
# Production VM: 103.215.107.180. Staging uses a different VM and environment.
# Copy to the local .env; no deployment secrets belong in this file.
COMPOSE_PROJECT_NAME=netloom-radius-production
APP_IMAGE=netloom-app:production
WEB_PORT=8000
DJANGO_ALLOWED_HOSTS=radius.netnoc.in,localhost,127.0.0.1
DJANGO_SECURE_COOKIES=true
DJANGO_CSRF_TRUSTED_ORIGINS=https://radius.netnoc.in
