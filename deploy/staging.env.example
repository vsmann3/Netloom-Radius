# Candidate staging hostname; DNS and HTTPS are pending user confirmation/setup.
# Use in the separate staging checkout, never the production directory.
COMPOSE_PROJECT_NAME=netloom-radius-staging
APP_IMAGE=netloom-app:staging
WEB_PORT=8001
DJANGO_ALLOWED_HOSTS=staging-radius.netnoc.in,localhost,127.0.0.1
DJANGO_SECURE_COOKIES=true
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging-radius.netnoc.in
