# Compose automatically reads a local .env. Image pins come from --env-file image-lock.env.
COMPOSE_PROJECT_NAME=netloom-radius-lab
APP_IMAGE=netloom-app:lab
WEB_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only false when accessing 127.0.0.1 through an SSH tunnel during lab setup.
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=
# Catalog-only integration; set up explicit bindings/tokens/plans before enabling.
CAF_CATALOG_ENABLED=false
# Exact reverse-proxy peer IP observed by Django; empty trusts no forwarded header.
CAF_CATALOG_PROXY_IPS=
