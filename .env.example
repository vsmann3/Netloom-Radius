# Compose automatically reads a local .env. Image pins come from --env-file image-lock.env.
COMPOSE_PROJECT_NAME=netloom-radius-lab
APP_IMAGE=netloom-app:lab
WEB_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only false when accessing 127.0.0.1 through an SSH tunnel during lab setup.
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=
# Catalog-only integration; set up explicit bindings/tokens/plans before enabling.
CAF_CATALOG_ENABLED=false
# Exact reverse-proxy peer IP observed by Django; empty trusts no forwarded header.
CAF_CATALOG_PROXY_IPS=
# Global gates remain OFF until a separately authorized rollout.
CAF_PRODUCTION_STAGED_ENABLED=false
CAF_PROVISIONING_ENABLED=false
CAF_API_ALLOWED_ORIGINS=https://ecaf.netnoc.in
CAF_FORM_URL=https://ecaf.netnoc.in/caf/new
CAF_FORM_ALLOWED_ORIGINS=https://ecaf.netnoc.in
CAF_FINGERPRINT_KEY_ID=v1
CAF_CREDENTIAL_KEY_ID=v1
# Use compose.caf-staged.yml to mount protected key rings; no values in this file.
